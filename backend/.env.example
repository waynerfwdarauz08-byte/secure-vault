NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://APP_USER:PASSWORD@HOST:5432/postgres
DB_TLS=true
# Optional PEM certificate contents, with literal \n between lines
DB_CA=
SESSION_SECRET=
DATA_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_32_BYTES_BASE64"}
ACTIVE_ENCRYPTION_KEY_ID=v1
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Trusted immediate proxy CIDRs only, established from actual deployment
TRUSTED_PROXIES=
# smtp: local SMTP or file fallback in development; brevo: HTTPS API (Render Free)
MAIL_TRANSPORT=smtp
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
